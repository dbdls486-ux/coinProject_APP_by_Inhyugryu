{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoinDeepDiveReport",
  "description": "주 3회 발행하는 코인 심층 리포트 1편. 기술 구조에 비중을 두고, 토크노믹스는 간략히.",
  "type": "object",
  "required": ["id", "date", "slot", "project", "ticker", "oneLiner", "sections", "numbers", "watchlist", "sources"],
  "properties": {
    "id": { "type": "string", "description": "YYYY-MM-DD-TICKER (소문자)", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+$" },
    "date": { "type": "string", "format": "date" },
    "slot": {
      "type": "string",
      "enum": ["new_listing", "outside_top100", "top100"],
      "description": "new_listing=최근 KRW 신규 상장 / outside_top100=시총 100위 밖 실사용 프로젝트 / top100=시총 100위 내"
    },
    "project": { "type": "string" },
    "ticker": { "type": "string" },
    "sector": { "type": "string", "description": "예: BTCFi · Liquid Restaking" },
    "oneLiner": { "type": "string", "description": "'쉽게 말하면 ~' 한 문장" },
    "krwMarkets": { "type": "array", "items": { "type": "string" }, "description": "원화 상장 거래소" },
    "sections": {
      "type": "object",
      "required": ["what", "tech", "usage", "tokenomics", "risks"],
      "properties": {
        "what": { "$ref": "#/$defs/section", "description": "① 뭐하는 프로젝트인가 / 왜 만들어졌나 (짧게)" },
        "tech": {
          "allOf": [{ "$ref": "#/$defs/section" }],
          "description": "② 기술 구조 — 가장 길게. 자금·데이터 흐름 단계, 신뢰 가정(누구를 믿어야 하나), 보안 경계, 경쟁 구조와의 기술적 차이",
          "properties": {
            "flow": { "type": "array", "items": { "type": "string" }, "description": "① 사용자 예치 → ② … 단계별 흐름 (5~9단계)" },
            "trustAssumptions": { "type": "array", "items": { "type": "string" }, "description": "운영자·오라클·브리지·검증자 등 신뢰해야 하는 주체" }
          }
        },
        "usage": { "$ref": "#/$defs/section", "description": "③ 실제 사용량과 매출 — TVL·활성 사용자·30일 fee/revenue, 숫자로" },
        "tokenomics": {
          "allOf": [{ "$ref": "#/$defs/section" }],
          "description": "④ 토크노믹스 — 3~5줄로 간략히: 유통률, 다음 언락, 가치귀속(매출→토큰 연결) 유무",
          "properties": {
            "valueCapture": { "type": "string", "enum": ["direct", "indirect", "none", "unclear"], "description": "direct=바이백/수수료 분배 등 직접 / indirect=스테이킹·가스 등 간접 / none=없음 / unclear=확인 불가" },
            "nextUnlock": { "type": ["string", "null"], "description": "예: 2026-12-20 · 7,083만 BR (공급 7.1%)" }
          }
        },
        "risks": { "$ref": "#/$defs/section", "description": "⑤ 리스크 — 기술·사업·공급 각 1~2개" }
      }
    },
    "numbers": {
      "type": "array",
      "description": "숫자로 보는 현재 (8~12개)",
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "properties": { "label": { "type": "string" }, "value": { "type": "string" }, "note": { "type": "string" } }
      }
    },
    "watchlist": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 6, "description": "앞으로 볼 지표" },
    "verdict": { "type": "string", "description": "핵심 결론 2~3문장 (투자 권유 아님, 구조 평가)" },
    "sources": {
      "type": "array",
      "items": { "type": "object", "required": ["title", "url"], "properties": { "title": { "type": "string" }, "url": { "type": "string" }, "accessed": { "type": "string" } } }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["title", "body"],
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "array", "items": { "type": "string" }, "description": "문단 배열. 마크다운 최소 사용(굵게 ** 만 허용)" },
        "table": {
          "type": "object",
          "properties": { "headers": { "type": "array", "items": { "type": "string" } }, "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } } }
        }
      }
    }
  }
}
